__pycache__/
dist/
build/
venv/
*.pyc

# Reference-only source imported from the playForm project for pattern
# study during the snapshot rewrite. Not part of the shipped application.
playform-imports/

# Compiled translation catalogs are generated by scripts/compile_lang.py
# from the .po sources - keep the build output out of version control.
lang/**/*.mo

# Written by `build.py --version=X.Y.Z` so app_info can report the released
# version; regenerated on every release build.
src/_build_version.py

# Compiled Qt resources (src/resources_rc.py) are deliberately *tracked* so a
# source checkout runs without a build step first - build.py regenerates them.

# Nuitka build report.
compilation-report.xml
